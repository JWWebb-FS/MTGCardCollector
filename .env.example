# API server
PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mtg_card_collector
LOG_LEVEL=info

# Vite app
# The app defaults to VITE_PORT=5173 and BASE_PATH=/ when these are unset.
VITE_PORT=5173
BASE_PATH=/

# Local browser dev uses Vite's /api proxy by default.
# Change this if the API server runs somewhere else.
VITE_API_PROXY_TARGET=http://localhost:5000

# Leave unset for normal web development.
# Set for external-device/mobile previews, for example:
# VITE_API_BASE_URL=http://192.168.1.25:5000
